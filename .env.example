DB_HOST=localhost
DB_PORT=porta_do_banco
DB_USER=user_do_banco
DB_PASSWORD=sua_senha_aqui
DB_NAME=nome_db

# Obrigatório em produção: mín. 32 caracteres aleatórios (não use o valor de exemplo)
JWT_SECRET=gere-uma-chave-longa-aleatoria-com-pelo-menos-32-chars

# Duração do JWT/cookie (ex.: 12h, 1d, 7d)
JWT_EXPIRES=12h

PORT=porta_da_api

# Origin do front (CORS + cookie Secure automático se URL for https://)
# Dev:  http://localhost:3000
# Prod: https://seu-dominio.com
VITE_APP_URL=http://localhost:3000

# Google Maps JavaScript API (tiles atualizados no Leaflet)
# Ative "Maps JavaScript API" no Google Cloud e restrinja a chave por HTTP referrer
# Produção: https://seu-dominio.com/*
VITE_GOOGLE_MAPS_API_KEY=sua_chave_google_maps

# true só com HTTPS (ex.: https://seu-dominio.com); false em HTTP local/LAN
# COOKIE_SECURE=false

# Fuso do app (dirigentes / "hoje")
APP_TIMEZONE=America/Sao_Paulo

# CEP padrão da região de trabalho (usado até o usuário definir outro em Configuração)
TERRITORY_CEP=01310-100

# Opcional — usado pelo script `npm run create:admin`
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=admin@campo.local

# Login com Google (OAuth 2.0 / OIDC)
# Crie credenciais em console.cloud.google.com (projeto com "OAuth consent screen"):
#   - URI de redirecionamento autorizada:
#       Produção: https://seu-dominio.com/api/auth/google/callback
#       Dev:       http://localhost:3000/api/auth/google/callback  (via proxy do Vite)
# O botão só aparece quando GOOGLE_CLIENT_ID e GOOGLE_CLIENT_SECRET estão definidos.
# GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx
#
# Opcional — lista de e-mails permitidos (separados por vírgula). Vazio = qualquer e-mail verificado.
# GOOGLE_ALLOWED_EMAILS=
