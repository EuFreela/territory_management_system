DB_HOST=localhost
DB_PORT=porta_do_banco
DB_USER=user_do_banco
DB_PASSWORD=sua_senha_aqui
DB_NAME=nome_db

# Obrigatório em produção: mín. 32 caracteres aleatórios (não use o valor de exemplo)
JWT_SECRET=gere-uma-chave-longa-aleatoria-com-pelo-menos-32-chars

# Duração do JWT/cookie (ex.: 12h, 1d, 7d)
JWT_EXPIRES=12h

PORT=porta_da_api
VITE_APP_URL=http://localhost:3000

# Google Maps JavaScript API (tiles atualizados no Leaflet)
# Ative "Maps JavaScript API" no Google Cloud e restrinja a chave por HTTP referrer
VITE_GOOGLE_MAPS_API_KEY=sua_chave_google_maps

# true só com HTTPS; false em HTTP local/LAN
# COOKIE_SECURE=false

# Fuso do app (dirigentes / "hoje")
APP_TIMEZONE=America/Sao_Paulo

# CEP único do sistema (por enquanto um território/região)
TERRITORY_CEP=01310-100
