    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "jose": "^6.2.7",
    "leaflet": "^1.9.4",
    "leaflet.gridlayer.googlemutant": "^0.16.0",
    "lucide-react": "^1.30.0",
    "maplibre-gl": "^5.6.2",
    "mysql2": "^3.23.2",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.7.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.7.1",
