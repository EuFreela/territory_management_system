{
  "name": "campo",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"npm run dev:server\" \"npm run dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/index.js",
    "preview": "vite preview",
    "migrate:rbac": "node scripts/migrate-rbac.js",
    "migrate:finish-history": "node scripts/migrate-finish-history.js",
    "migrate:theme": "node scripts/migrate-theme-preference.js",
    "migrate:block-description": "node scripts/migrate-block-description.js",
    "migrate:daily-per-leader": "node scripts/migrate-daily-per-leader.js",
    "migrate:territory-reviewed": "node scripts/migrate-territory-reviewed.js",
    "migrate:google-oauth": "node scripts/migrate-google-oauth.js",
    "migrate:active-cep": "node scripts/migrate-active-cep.js",
    "migrate:territory-image-url": "node scripts/migrate-territory-image-url.js",
    "migrate:cep-congregation": "node scripts/migrate-cep-congregation.js",
    "create:admin": "node scripts/create-admin.js"
  },
  "dependencies": {
